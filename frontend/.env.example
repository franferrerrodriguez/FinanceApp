# Copy to .env and adjust for how you want to sign in.

# --- Supabase mode (default) ---
# No emails on sign-up: disable "Confirm email" in the dashboard (see supabase/SETUP.md §2).
# Fill from Supabase → Project Settings → API
# Use the "publishable" key (sb_publishable_…) or "anon public" (eyJ…). They are equivalent on the client.
# NEVER put here: service_role, Postgres password, or DATABASE_URL.

VITE_SUPABASE_URL=https://TU-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-public-key

# Web Push (PWA) — generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
